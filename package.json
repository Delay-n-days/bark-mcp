{
  "name": "bark-mcp",
  "version": "1.0.0",
  "description": "Bark 推送 + stdio MCP 服务：npx -y 即用，给大模型发 iOS 通知（含 Bark 官方 AES 加密）",
  "type": "module",
  "private": false,
  "bin": {
    "bark-mcp": "dist/bark-mcp.js"
  },
  "files": [
    "dist/bark-mcp.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node --experimental-strip-types scripts/gen-web.ts && node --experimental-strip-types scripts/build.ts",
    "start": "node dist/bark-mcp.js",
    "serve": "node dist/bark-mcp.js",
    "mcp": "node dist/bark-mcp.js mcp",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "pack:tgz": "npm pack",
    "prepack": "npm run build"
  },
  "keywords": [
    "bark",
    "bark-push",
    "mcp",
    "model-context-protocol",
    "apns",
    "ios-push",
    "node",
    "npx"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "npm": ">=9"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3"
  }
}
