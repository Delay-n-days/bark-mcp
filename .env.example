# 必填：Bark 设备 key（App 首页那串），同时作为 HTTP 服务的访问令牌
BARK_KEY="your-device-key"

# Bark 服务器，自建服务器时改成自己的地址
BARK_SERVER="https://api.day.app"

# Web 服务监听地址，默认只监听本机
BARK_HOST="127.0.0.1"
BARK_PORT=8787

# 需要让局域网/公网访问时打开（此时必须配置 BARK_KEY 或 BARK_MCP_TOKEN）
# BARK_REQUIRE_AUTH=1
# BARK_MCP_TOKEN=""

# 设为 0 禁止调用方自带 device_key（多设备场景再打开）
# BARK_ALLOW_CUSTOM_KEY=0

# 加密密钥文件位置，默认 ./crypto_keys.json
# BARK_KEYS_FILE="./crypto_keys.json"
